From 8cc77d81263f69bb47f56bbc7bd5cd001d45314f Mon Sep 17 00:00:00 2001
From: Yuri Andriaccio <yurand2000@gmail.com>
Date: Wed, 4 Dec 2024 15:34:49 +0100
Subject: [PATCH 11/15] Fix incorrect enqueueing of stopped dl_servers

To be squashed in a previous commit
---
 kernel/sched/deadline.c | 4 ++++
 kernel/sched/rt.c       | 3 +++
 2 files changed, 7 insertions(+)

diff --git a/kernel/sched/deadline.c b/kernel/sched/deadline.c
index 02c81e9f9..d993f196c 100644
--- a/kernel/sched/deadline.c
+++ b/kernel/sched/deadline.c
@@ -1622,6 +1622,9 @@ static void update_curr_dl_se(struct rq *rq, struct sched_dl_entity *dl_se, s64
 {
 	s64 scaled_delta_exec;
 
+	if (dl_server(dl_se) && !on_dl_rq(dl_se))
+		return;
+
 	if (unlikely(delta_exec <= 0)) {
 		if (unlikely(dl_se->dl_yielded))
 			goto throttle;
@@ -2562,6 +2565,7 @@ static struct task_struct *__pick_task_dl(struct rq *rq)
 			}
 			goto again;
 		}
+		BUG_ON(!p);
 		rq->dl_server = dl_se;
 	} else {
 		p = dl_task_of(dl_se);
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 1e09f3b5b..281b363b1 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -162,6 +162,9 @@ static struct task_struct *rt_server_pick(struct sched_dl_entity *dl_se)
 	struct rq *rq = rq_of_rt_rq(rt_rq);
 	struct task_struct *p;
 
+	if (dl_se->my_q->rt.rt_nr_running == 0)
+		return NULL;
+
 	p = _pick_next_task_rt(rt_rq);
 	set_next_task_rt(rq, p, true);
 
